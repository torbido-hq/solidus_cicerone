# frozen_string_literal: true

# Isolated client/payload specs — no Solidus install required.
source "https://rubygems.org"

gem "bundler-audit", "~> 0.9"
gem "cicerone", git: "https://github.com/torbido-hq/cicerone.rb.git", branch: "main"
gem "rake"
gem "rspec", "~> 3.13"
gem "rubocop", "~> 1.81"
gem "simplecov", "~> 0.22", require: false
gem "webmock", "~> 3.24"
